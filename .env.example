# Giggle Studio Environment Configuration Example
# Copy this file to .env and adjust values as needed.
# NEVER commit .env to version control!

# Core Server Settings
GIGGLE_HOST=127.0.0.1
GIGGLE_PORT=8420
GIGGLE_DEBUG=false
GIGGLE_SECRET_KEY=change-this-to-a-secure-random-32-byte-hex-string
GIGGLE_DATA_DIR=./data

# GPU / Accelerator Configuration
# Auto-detects NVIDIA RTX 5070 index via NVML if empty
GIGGLE_CUDA_DEVICE=auto
GIGGLE_VRAM_MARGIN_MB=600
GIGGLE_RAM_CEILING_PERCENT=85

# Optional OpenAI-Compatible Server (/v1)
# Disabled by default for maximum security
GIGGLE_OPENAI_COMPAT_ENABLED=false
GIGGLE_OPENAI_COMPAT_API_KEY=

# Hugging Face Access (Optional, for downloading gated models/datasets)
HF_TOKEN=

# Gmail Integration (Optional - configured via UI wizard)
# Users provide their own Google Cloud OAuth 2.0 Desktop credentials
GIGGLE_GMAIL_CLIENT_ID=
GIGGLE_GMAIL_CLIENT_SECRET=
